# Copy to .env and fill in from the LINE Developers console (Messaging API channel).
LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_long_lived_access_token
PORT=3000

# REQUIRED in production: Postgres (Supabase/Neon). Stores courses, score history
# AND the live game state, so a restart / free-tier sleep does not kill a round.
# Without it the bot loses the game every time the instance sleeps (~15 min idle).
# Use the "Connection string (URI)".
DATABASE_URL=

# Public URL of this service. Set it so the app pings its own /health every
# 10 min and Render's free instance never sleeps mid-round.
SELF_URL=https://caddiebot.onrender.com
# KEEPALIVE_MS=600000
