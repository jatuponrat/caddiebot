# Copy to .env and fill in from the LINE Developers console (Messaging API channel).
LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_long_lived_access_token
PORT=3000

# Optional: Postgres (Supabase/Neon) for persistent courses + score history.
# Leave blank to run fully in-memory. Use the "Connection string (URI)".
DATABASE_URL=
